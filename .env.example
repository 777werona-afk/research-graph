# Скопируйте в .env и при необходимости поменяйте значения:
#   cp .env.example .env
# Файл .env не коммитится (см. .gitignore).

# Персональный токен GitHub (можно оставить пустым)
RG_GITHUB_TOKEN=
# Директория для данных (снимки, Bronze/Silver/Gold)
RG_DATA_DIR=data
# DEBUG | INFO | WARNING | ERROR | CRITICAL
RG_LOG_LEVEL=INFO
# text | json
RG_LOG_FORMAT=text
# Таймаут HTTP-запросов, секунды (0 < x <= 300)
RG_REQUEST_TIMEOUT=10
# Одновременных запросов (1..64)
RG_MAX_CONCURRENCY=4
